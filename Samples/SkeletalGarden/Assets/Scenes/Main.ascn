format: ada.scene
schemaVersion: 1
scene:
  id: skeletal-garden
  name: Skeletal Garden
entities:
- id: garden-0000
  name: Controlled Robot
  enabled: true
  components:
    AdaScene.ModelAnimationPlayback3DComponent:
      speed: 1
      clip: Idle
      transitionDuration: 2.2e-1
      synchronizePhase: true
      isPlaying: true
      repeats: true
    AdaScene.Model3DSource:
      source: '@res://GardenRobot.glb'
      repeats: true
      animation: Idle
      autoplay: true
      lod:
        sources:
        - '@res://GardenRobotLOD1.glb'
        - '@res://GardenRobotLOD2.glb'
        fadeDistance: 5
        skeletonCompatible: true
        screenThresholds:
        - 1.8e-1
        - 7e-2
        animationLOD: false
        maximumDistance: null
    AdaPhysics.CharacterController3DComponent:
      height: 2.15e+0
      radius: 4e-1
    AdaTransform.Transform:
      scale:
      - 5e-1
      - 5e-1
      - 5e-1
      position:
      - -7e-1
      - 0
      - 0
      rotation:
      - 0
      - 1e+0
      - 0
      - 6.123233995736766e-17
- id: garden-0001
  name: Reference Robot
  enabled: true
  components:
    AdaScene.Model3DSource:
      animation: Walk
      autoplay: true
      source: '@res://GardenRobot.glb'
      repeats: true
      lod:
        maximumDistance: null
        sources:
        - '@res://GardenRobotLOD1.glb'
        - '@res://GardenRobotLOD2.glb'
        fadeDistance: 5
        animationLOD: true
        screenThresholds:
        - 1.8e-1
        - 7e-2
        skeletonCompatible: true
    AdaTransform.Transform:
      scale:
      - 3.8e-1
      - 3.8e-1
      - 3.8e-1
      position:
      - 1.5e+0
      - 0
      - 1.8e+0
      rotation:
      - 0
      - 1e+0
      - 0
      - 6.123233995736766e-17
    AdaScene.ModelAnimationPlayback3DComponent:
      repeats: true
      clip: Walk
      isPlaying: true
      transitionDuration: 2.2e-1
      synchronizePhase: true
      speed: 6.5e-1
