{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/AdaEngine/AdaExamples/catalog.schema.json",
  "title": "AdaExamples Catalog",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "repository", "defaultRef", "releaseBaseURL", "tagDefinitions", "items"],
  "properties": {
    "$schema": { "type": "string" },
    "schemaVersion": { "const": 1 },
    "repository": { "type": "string", "format": "uri" },
    "defaultRef": { "type": "string", "minLength": 1 },
    "releaseBaseURL": { "type": "string", "format": "uri" },
    "tagDefinitions": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "group"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "group": {
            "enum": ["language", "dimension", "genre", "feature", "platform"]
          }
        }
      }
    },
    "items": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "kind", "title", "description", "path", "preview", "archive", "tags"],
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
          "kind": { "enum": ["example", "sample"] },
          "title": { "type": "string", "minLength": 1 },
          "description": { "type": "string", "minLength": 1 },
          "path": { "type": "string", "minLength": 1 },
          "preview": { "type": "string", "minLength": 1 },
          "archive": { "type": "string", "pattern": "^[A-Za-z0-9-]+\\.zip$" },
          "tags": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": { "type": "string", "minLength": 1 }
          }
        }
      }
    }
  }
}
